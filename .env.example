# Local testing only. Copy to .env; Node does not read this automatically.
# Start with: node --env-file=.env src/server.ts
FF_MODE=local-test
# Email and password only by default. Set to 1 to test email verification + admin TOTP.
FF_REQUIRE_VERIFICATION=0
FF_HOST=127.0.0.1
FF_PORT=8085
FF_DATA_DIR=./data
# Leave unset for the loopback default. Must match the browser origin exactly.
# FF_ORIGIN=http://127.0.0.1:8085

# Optional Google client sign-in. Use a Google Cloud Web application OAuth client.
# Register http://127.0.0.1:8085/api/auth/google/callback as its redirect URI.
# FF_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# FF_GOOGLE_CLIENT_SECRET=your-client-secret
# Termux: add these as export lines in ~/.config/form-fire/env instead.
